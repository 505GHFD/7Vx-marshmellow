UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    local isAltPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)

    -- ALT + Z untuk restore semua dinding yang tersembunyi
    if input.KeyCode == Enum.KeyCode.Z and isAltPressed then
        for part, originalCollide in pairs(hiddenWalls) do
            if part and part.Parent then
                part.LocalTransparencyModifier = 0
                part.CanCollide = originalCollide
            end
            hiddenWalls[part] = nil
        end
        notify("WALL DEBUG", "Undo: semua wall lokal yang disembunyikan telah dipulihkan.")
        return
    end

    -- Toggle UI
    if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.RightControl then
        if window.Visible then
            window.Visible = false
            closedImage.Visible = true
        else
            window.Visible = true
            closedImage.Visible = false
        end
    -- Blink TP
    elseif input.KeyCode == Enum.KeyCode.T and State.Blink then
        local root = getRoot()
        if root then root.CFrame = root.CFrame + root.CFrame.LookVector * 6 end
    end

    -- ALT + M1 (Klik Kiri) untuk menghapus (menembus) dinding (One Way / Tidak bisa restore)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and State.WallDeleteMode and isAltPressed then
        local mouse = Player:GetMouse()
        local target = mouse.Target
        if target and target:IsA("BasePart") then
            local wasHidden = target.LocalTransparencyModifier == 1
            if not wasHidden then
                -- Simpan kolisi aslinya jika kita ingin restore via ALT+Z
                hiddenWalls[target] = target.CanCollide
                
                target.LocalTransparencyModifier = 1
                target.CanCollide = false
                notify("WALL DEBUG", "Deleted & Passable: " .. target:GetFullName())
            else
                -- Jika sudah disembunyikan, klik lagi tidak akan memulihkannya.
                notify("WALL DEBUG", "Cannot restore by clicking. Use ALT+Z.")
            end
        end
    end
end)

