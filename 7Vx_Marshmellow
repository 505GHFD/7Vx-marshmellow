createUndergroundFloor = function()
    if undergroundPart and undergroundPart.Parent then return undergroundPart end
    local root = getRoot()
    if not root then return nil end

    -- Teleportasikan player 7 studs ke bawah terlebih dahulu
    root.CFrame = root.CFrame * CFrame.new(0, -7, 0)

