local espOverlay = new("ScreenGui", {Name = "7Vx_ESPOverlay", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global}, PlayerGui)
local espFolder = new("Folder", {Name = "ESPObjects"}, espOverlay)

local function makeLine(parent, z)
    return new("Frame", {BackgroundColor3 = CFG.PURPLE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = z or 10}, parent)
end

local function setLine(line, a, b, thickness)
    local delta = b - a
    local length = delta.Magnitude
    if length < 1 then line.Visible = false return end
    line.Visible = true
    line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    line.Size = UDim2.fromOffset(length, thickness or 2)
    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
end

local function destroyESP(player)
    local data = esp[player]
    if data then
        if data.root and data.root.Parent then data.root:Destroy() end
        esp[player] = nil
    end
end

local function getScreenPoint(part)
    if not part then return nil, false end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    return Vector2.new(pos.X, pos.Y), onScreen and pos.Z > 0
end

local function createESP(player)
    local rootGui = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = espFolder, ZIndex = 5})
    local box = new("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Parent = rootGui, ZIndex = 6})
    outline(box, CFG.PURPLE, 2)
    local healthBack = new("Frame", {BackgroundColor3 = Color3.fromRGB(25,25,30), BorderSizePixel = 0, Parent = rootGui, ZIndex = 7})
    local healthFill = new("Frame", {BackgroundColor3 = CFG.PURPLE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0,1), Parent = healthBack, ZIndex = 8})
    local info = new("TextLabel", {BackgroundTransparency = 1, TextColor3 = CFG.TEXT, TextStrokeTransparency = 0.2, Font = CFG.FONT, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, Parent = rootGui, ZIndex = 9})
    local skeleton = {}
    for i = 1, 18 do skeleton[i] = makeLine(rootGui, 7) end
    local tracer = makeLine(rootGui, 8)
    tracer.Visible = false
    return {root = rootGui, box = box, healthBack = healthBack, healthFill = healthFill, info = info, skeleton = skeleton, tracer = tracer}
end

local function updateSkeleton(data, char)
    local pairsList = {
        {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
        {"Head","Torso"},{"Torso","Left Arm"},{"Left Arm","Left Leg"},{"Torso","Right Arm"}
    }
    for i, pair in ipairs(pairsList) do
        local a = char:FindFirstChild(pair[1])
        local b = char:FindFirstChild(pair[2])
        local line = data.skeleton[i]
        if a and b then
            local ap, ao = getScreenPoint(a); local bp, bo = getScreenPoint(b)
            if ap and bp and (ao or bo) then setLine(line, ap, bp, 2) else line.Visible = false end
        else
            line.Visible = false
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not State.ESP then
        for player in pairs(esp) do destroyESP(player) end
        return
    end

    Camera = workspace.CurrentCamera or Camera
    local localRoot = getRoot()
    if not localRoot then return end
    local nearest, nearestDist = nil, 100

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player and player.Character then
            local char = player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and head then
                local dist = (localRoot.Position - root.Position).Magnitude
                if dist <= math.min(State.MaxDistance, 10000) then
                    if not esp[player] then esp[player] = createESP(player) end
                    local data = esp[player]
                    local top, topOn = getScreenPoint(head)
                    local bottom, bottomOn = getScreenPoint(root)
                    if top and bottom and (topOn or bottomOn) then
                        local h = math.max(25, math.abs(bottom.Y - top.Y) * 1.15)
                        local w = math.max(18, h * 0.55)
                        local x = top.X - w/2
                        local y = math.min(top.Y, bottom.Y) - h*0.08
                        data.box.Position = UDim2.fromOffset(x, y)
                        data.box.Size = UDim2.fromOffset(w, h)
                        data.box.Visible = State.BoxESP
                        data.healthBack.Position = UDim2.fromOffset(x - 6, y)
                        data.healthBack.Size = UDim2.fromOffset(3, h)
                        data.healthBack.Visible = State.ShowHealth
                        local hp = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 0
                        data.healthFill.Size = UDim2.new(1, 0, hp, 0)
                        data.healthFill.Position = UDim2.new(0, 0, 1, 0)
                        data.info.Position = UDim2.fromOffset(x, y - 30)
                        data.info.Size = UDim2.fromOffset(w, 28)
                        local lines = {}
                        if State.ShowName then table.insert(lines, player.Name) end
                        if State.ShowStuds then table.insert(lines, string.format("%.1f studs", dist)) end
                        if State.ShowHold then table.insert(lines, "HOLD: " .. getHeldItem(player)) end
                        if State.ShowInventory then
                            local inv = getInventory(player)
                            local invParts = {}
                            for n,c in pairs(inv) do table.insert(invParts, n .. " x" .. c) end
                            table.sort(invParts)
                            table.insert(lines, (#invParts > 0 and "INV: " .. table.concat(invParts, ", ") or "INV: -"))
                        end
                        data.info.Text = table.concat(lines, "\n")
                        data.info.Visible = #lines > 0
                        updateSkeleton(data, char)

                        if State.Tracers and dist <= 100 and dist < nearestDist then
                            nearest, nearestDist = player, dist
                        end
                    end
                else
                    destroyESP(player)
                end
            else
                destroyESP(player)
            end
        end
    end

    for player, data in pairs(esp) do data.tracer.Visible = false end
    if State.Tracers and nearest and esp[nearest] then
        local head = nearest.Character and nearest.Character:FindFirstChild("Head")
        local hp, on = getScreenPoint(head)
        if hp and on then
            local mp = UserInputService:GetMouseLocation()
            setLine(esp[nearest].tracer, Vector2.new(mp.X, mp.Y), hp, 2)
        end
    end
end)

