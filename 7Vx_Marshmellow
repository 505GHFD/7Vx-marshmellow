    local function doBlinkTP()
        local root = getRoot()
        local hum = getHumanoid()
        if not root or not hum then
            notify("BLINK TP", "Character belum siap.", true)
            return false
        end

        local distance = 6
        local direction = root.CFrame.LookVector
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {getCharacter()}

        -- Blink is allowed to pass through a wall, but collision is disabled only for the tiny
        -- teleport window so the character does not get caught by local collision resolution.
        local changed = {}
        local char = getCharacter()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    changed[part] = part.CanCollide
                    part.CanCollide = false
                end
            end
        end

        local destination = root.Position + direction * distance
        local hit = workspace:Raycast(root.Position, direction * distance, params)
        if hit then
            -- Do not stop at the wall: place the player a small distance past it.
            destination = hit.Position + direction * 2.5 + Vector3.new(0, 0.05, 0)
        end

        local oldPosition = root.Position
        local blinkDistance = (destination - oldPosition).Magnitude
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.lookAt(destination, destination + direction)

        task.delay(0.12, function()
            for part, oldValue in pairs(changed) do
                if part and part.Parent then part.CanCollide = oldValue end
            end
        end)

        notify("BLINK TP", "Blink " .. string.format("%.1f", blinkDistance) .. " studs | NOCLIP WINDOW")
        return true
    end
