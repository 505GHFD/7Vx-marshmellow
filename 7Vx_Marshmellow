local function text(parent, value, x, y, w, h, size, color)
    return new("TextLabel", { Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, Text = value, TextColor3 = color or CFG.TEXT, Font = CFG.FONT, TextSize = size or 12, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center }, parent)
end
local function actionButton(parent, value, x, y, w, h, callback)
    local b = new("TextButton", { Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundColor3 = CFG.PANEL2, BorderSizePixel = 0, Text = value, TextColor3 = CFG.TEXT, Font = CFG.FONT, TextSize = 12, AutoButtonColor = false }, parent)
    round(b, 7)
    b.MouseButton1Click:Connect(callback)
    b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = CFG.PURPLE_DARK}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = CFG.PANEL2}):Play() end)
    return b
end
local function toggle(parent, labelText, key, x, y, callback)
    local b = new("TextButton", { Size = UDim2.fromOffset(225, 34), Position = UDim2.fromOffset(x, y), BackgroundColor3 = State[key] and CFG.PURPLE_DARK or CFG.PANEL2, BorderSizePixel = 0, Text = labelText .. " : " .. (State[key] and "ON" or "OFF"), TextColor3 = CFG.TEXT, Font = CFG.FONT, TextSize = 11, AutoButtonColor = false }, parent)
    round(b, 7)
    b.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        if callback then callback(State[key]) end
        renderTab()
    end)
    return b
end

