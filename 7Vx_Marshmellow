        local isGlass = style == "GLASS"
        local isNeon = style == "NEON"
        local isMinimal = style == "MINIMAL"
        local panelTransparency = isGlass and 0.18 or 0

        -- Keep the panel readable in Glass while making the background visibly translucent.
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("Frame") then
                if obj == window then
                    obj.BackgroundTransparency = isGlass and 0.16 or 0
                elseif obj.Name == "Sidebar" then
                    obj.BackgroundTransparency = isGlass and 0.12 or 0
                elseif obj:GetAttribute("UIPanel") then
                    obj.BackgroundTransparency = panelTransparency
                end
            elseif obj:IsA("UIStroke") then
                if isMinimal then
                    obj.Transparency = 1
                elseif isNeon then
                    obj.Transparency = 0.02
                    obj.Thickness = 1.8
                    obj.Color = CFG.PURPLE
                elseif isGlass then
                    obj.Transparency = 0.18
                    obj.Thickness = 1.1
                else
                    obj.Transparency = 0.25
                    obj.Thickness = 1
                end
            end
        end

        -- Neon uses layered strokes as a lightweight glow; no external image asset required.
        for _, layer in ipairs(styleGlowLayers) do
            if layer and layer.Parent then layer:Destroy() end
