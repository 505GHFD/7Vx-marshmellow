    local function getVehicleSeat()
        local hum = getHumanoid()
        if not hum then return nil end
        local seat = hum.SeatPart
        if seat and seat:IsA("VehicleSeat") then return seat end
        return nil
    end

    local function getVehicleRoot(seat)
        if not seat then return nil end
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then
            if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
                return model.PrimaryPart
            end
            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "Chassis" or obj.Name == "Main" or obj.Name == "Body") then
                    return obj
                end
            end
        end
        return seat
    end

    local function stopVehicleFly(silent)
        State.VehicleFly = false
        if vehicleFlyConnection then
            vehicleFlyConnection:Disconnect()
            vehicleFlyConnection = nil
        end
        if vehicleFlyVelocity then
            vehicleFlyVelocity:Destroy()
            vehicleFlyVelocity = nil
        end
        if vehicleFlyGyro then
            vehicleFlyGyro:Destroy()
            vehicleFlyGyro = nil
        end
        if not silent then notify("FLY VEHICLE", "OFF") end
    end

    local function startVehicleFly()
        local seat = getVehicleSeat()
        if not seat then
            State.VehicleFly = false
            notify("FLY VEHICLE", "Kamu tidak sedang berada di kendaraan.", true)
            return false
        end

        local root = getVehicleRoot(seat)
        if not root then
            State.VehicleFly = false
            notify("FLY VEHICLE", "Vehicle root tidak ditemukan.", true)
            return false
        end

        stopVehicleFly(true)
        State.VehicleFly = true

        vehicleFlyVelocity = Instance.new("BodyVelocity")
        vehicleFlyVelocity.Name = "7VxVehicleFlyVelocity"
        vehicleFlyVelocity.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        vehicleFlyVelocity.P = 12000
        vehicleFlyVelocity.Velocity = Vector3.zero
        vehicleFlyVelocity.Parent = root

        vehicleFlyGyro = Instance.new("BodyGyro")
        vehicleFlyGyro.Name = "7VxVehicleFlyGyro"
        vehicleFlyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        vehicleFlyGyro.P = 10000
        vehicleFlyGyro.D = 800
        vehicleFlyGyro.CFrame = root.CFrame
        vehicleFlyGyro.Parent = root

        vehicleFlyConnection = RunService.Heartbeat:Connect(function(dt)
            if not State.VehicleFly then return end

            local currentSeat = getVehicleSeat()
            if not currentSeat then
                stopVehicleFly()
                return
            end

            local currentRoot = getVehicleRoot(currentSeat)
            if currentRoot ~= root or not root.Parent then
                stopVehicleFly()
                return
            end

            local camera = workspace.CurrentCamera
            if not camera then return end

            local flatLook = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            local flatRight = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)
            if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0,0,-1) end
            if flatRight.Magnitude < 0.01 then flatRight = Vector3.new(1,0,0) end
            flatLook = flatLook.Unit
            flatRight = flatRight.Unit

            -- Explicit vehicle-fly controls:
            -- W = forward, S = reverse, A/D = steer, Space = up, Ctrl = down.
            local throttle = 0
            local steer = 0

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                throttle += 1
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                throttle -= 1
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                steer -= 1
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                steer += 1
            end

            local forward = flatLook * throttle
            local sideways = flatRight * steer * 0.55

            local vertical = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                vertical += 1
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                vertical -= 1
            end

            local target = (forward + sideways) * State.VehicleFlySpeed
                + Vector3.new(0, vertical * State.VehicleFlySpeed, 0)
            vehicleFlyVelocity.Velocity = vehicleFlyVelocity.Velocity:Lerp(target, math.clamp(dt * 8, 0, 1))
            vehicleFlyGyro.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
        end)

        notify("FLY VEHICLE", "ON | W/S maju-mundur • A/D belok • Space/Ctrl naik-turun.")
        return true
    end

    local function toggleVehicleFly()
        if State.VehicleFly then
            stopVehicleFly()
        else
            startVehicleFly()
        end
    end


