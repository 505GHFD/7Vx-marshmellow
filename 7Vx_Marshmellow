local function log(text, isRejection, reason)
    table.insert(State.Logs, 1, { Time = os.date("%H:%M:%S"), Text = text })
    while #State.Logs > 100 do table.remove(State.Logs) end
    if isRejection then notify("REJECTED", reason or text, true) end
end

local function getInventory(player)
    local inventory = {}
    local function scan(container)
        if not container then return end
        for _, object in ipairs(container:GetChildren()) do
            if object:IsA("Tool") then inventory[object.Name] = (inventory[object.Name] or 0) + 1 end
        end
    end
    scan(player:FindFirstChild("Backpack"))
    scan(player.Character)
    return inventory
end

local function countItem(name) return getInventory(Player)[name] or 0 end
local function getTotalIngredients() return countItem(CFG.WATER) + countItem(CFG.SUGAR) + countItem(CFG.GELATIN) end
local function getMarshmallowCount() return countItem(CFG.SMALL) + countItem(CFG.MEDIUM) + countItem(CFG.LARGE) end

local function getHeldItem(player)
    if not player.Character then return "-" end
    for _, object in ipairs(player.Character:GetChildren()) do
        if object:IsA("Tool") then return object.Name end
    end
    return "-"
end

local function equipItem(name)
    local character = Player.Character
    local backpack = Player:FindFirstChild("Backpack")
    if not character or not backpack then return false end
    local tool = backpack:FindFirstChild(name) or character:FindFirstChild(name)
    if not tool or not tool:IsA("Tool") then return false end
    local humanoid = getHumanoid()
    if humanoid then humanoid:EquipTool(tool); return true end
    return false
end

local function getMarshmallowRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("MarshmallowRemotes")
        or ReplicatedStorage:FindFirstChild("Remotes")
        or ReplicatedStorage:FindFirstChild("Events")
    if not folder then return nil end

    local remote = folder:FindFirstChild(name)
    if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
        return remote
    end
    return nil
end

local function fireRemote(name, ...)
    local remote = getMarshmallowRemote(name)
    if not remote then return false end

    local args = table.pack(...)
    local ok = pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(table.unpack(args, 1, args.n))
        else
            remote:InvokeServer(table.unpack(args, 1, args.n))
        end
    end)
    return ok
end

