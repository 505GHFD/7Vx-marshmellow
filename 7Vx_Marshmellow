local function buyIngredient(name, amount)
    amount = math.max(1, tonumber(amount) or 1)
    local prompt = findNearestInteractPrompt(15, {"buy", string.lower(name)})
    if not prompt then
        notify("BUY", "Buy prompt untuk " .. tostring(name) .. " tidak ditemukan.", true)
        return false
    end
    for _ = 1, amount do
        interactPrompt(prompt, 0.08)
        task.wait(0.2)
    end
    notify("BUY", tostring(name) .. " x" .. tostring(amount) .. " diproses.")
    return true
end

