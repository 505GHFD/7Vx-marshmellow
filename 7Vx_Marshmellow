    local function getBuyKeywords(name)
        local lower = string.lower(tostring(name))
        if lower == "water" then return BUY_ITEM_KEYWORDS.Water end
        if lower == "sugar" or lower == "sugar block bag" then return BUY_ITEM_KEYWORDS.Sugar end
        if lower == "gelatin" then return BUY_ITEM_KEYWORDS.Gelatin end
        return {lower, "buy", "purchase", "shop"}
    end

    local function buyIngredient(name, amount)
        amount = math.max(1, math.floor(tonumber(amount) or 1))
        if buyingBusy then
            notify("BUY", "Pembelian masih berjalan.", true)
            return false
        end

        buyingBusy = true
        local okAny = false
        local keywords = getBuyKeywords(name)

        for i = 1, amount do
            if not buyingBusy then break end

            local prompt = findNearestInteractPrompt(50, keywords)

            if not prompt then
                notify("BUY", "Prompt untuk " .. tostring(name) .. " tidak ditemukan. Dekati NPC/shop.", true)
                break
            end

            if interactPrompt(prompt, 0.08) then
                okAny = true
                State.CurrentStep = string.format("BUY %s %d/%d", tostring(name), i, amount)
                task.wait(math.max(0.15, State.BuyDelay))
            else
                break
            end
        end

        if okAny then
            notify("BUY", tostring(name) .. " x" .. tostring(amount) .. " selesai diproses.")
            log("BUY: " .. tostring(name) .. " x" .. tostring(amount))
        end

        buyingBusy = false
        return okAny
    end

    local function sellOneMarshmallow(itemName)
        if countItem(itemName) <= 0 then return false end

        -- Equip the exact marshmallow BAG first.
        if not equipItem(itemName) then
            notify("SELL", "Gagal equip " .. tostring(itemName) .. ".", true)
            return false
        end

        task.wait(0.4)

        -- Find the selling interaction only after the correct bag is equipped.
        local prompt = findNearestInteractPrompt(30, {
            "sell",
            string.lower(itemName),
            string.lower(itemName:gsub(" marshmellow bag", "")),
            string.lower(itemName:gsub(" marshmallow bag", "")),
        })

        if not prompt then
            notify("SELL", "Prompt jual tidak ditemukan. Dekati NPC/penjual marshmallow.", true)
            return false
        end

        -- Hold the interaction for 3.5-4.0 seconds.
        local hold = 3.5 + (math.random(0, 5) / 10)
        hold = math.min(4.0, hold)

        State.CurrentStep = string.format("HOLD E: %s (%.1fs)", itemName, hold)

        -- Sell interaction memakai VirtualInputManager:
        -- key-down E -> tahan 3.5-4.0s -> key-up E
        local ok, err = pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(hold)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        -- Pastikan E dilepas walaupun terjadi error saat hold.
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        if not ok then
            notify("SELL", "VirtualInputManager gagal: " .. tostring(err), true)
            return false
        end

        State.SoldCount += 1
        local price = CFG.SELL_PRICE[itemName] or 0
        State.TotalProfit += price
        log(string.format("SELL: %s | +$%d | HOLD E %.1fs", itemName, price, hold))
        task.wait(math.max(0.20, State.SellDelay))
        return true
    end

