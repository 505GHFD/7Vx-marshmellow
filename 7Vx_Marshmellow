findNearestInteractPrompt = function(maxDistance, keywords)
    local root = getRoot()
    if not root then return nil, math.huge end
    local best, bestDist = nil, maxDistance or 12
    keywords = keywords or {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            local part = parent and (parent:IsA("BasePart") and parent or parent:FindFirstAncestorWhichIsA("BasePart"))
            if part then
                local d = (root.Position - part.Position).Magnitude
                local hay = string.lower((obj.ActionText or "") .. " " .. (obj.ObjectText or "") .. " " .. obj.Name .. " " .. part.Name)
                local match = #keywords == 0
                for _, kw in ipairs(keywords) do
                    if hay:find(string.lower(kw), 1, true) then match = true break end
                end
                if match and d <= bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end
    return best, bestDist
end

interactPrompt = function(prompt, holdDuration)
    if not prompt then return false end
    local ok = pcall(function()
        if holdDuration and holdDuration > 0 then
            prompt:InputHoldBegin()
            task.wait(holdDuration)
            prompt:InputHoldEnd()
        else
            prompt:InputHoldBegin()
            task.wait(0.08 + (math.random(1, 5) / 100))
            prompt:InputHoldEnd()
        end
    end)
    if ok then return true end
    return holdE(holdDuration or 0.08)
end

