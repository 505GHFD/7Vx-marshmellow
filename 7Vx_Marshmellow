        amount = math.max(1, math.floor(tonumber(amount) or 1))

        if sellingBusy then
            notify("SELL", "Penjualan masih berjalan.", true)
            return false
        end

        if countItem(itemName) <= 0 then
            notify("SELL", "Tidak ada " .. tostring(itemName) .. " untuk dijual.", true)
            return false
        end

        sellingBusy = true
        local sold = 0

        for i = 1, amount do
            if countItem(itemName) <= 0 then break end

            State.CurrentStep = string.format("SELL %s %d/%d", tostring(itemName), i, amount)

            if sellOneMarshmallow(itemName) then
                sold += 1
            else
                break
            end
        end

        if sold > 0 then
            local price = CFG.SELL_PRICE[itemName] or 0
            notify("SELL", string.format("%s x%d | +$%d", itemName, sold, price * sold))
        end

        sellingBusy = false
        return sold > 0
    end

    local function sellAllMarshmallowsOrdered()
        if sellingBusy then return false end

        sellingBusy = true
        local totalSold = 0
        local order = {CFG.LARGE, CFG.MEDIUM, CFG.SMALL}

        for _, itemName in ipairs(order) do
            while countItem(itemName) > 0 do
                State.CurrentStep = "SELL " .. tostring(itemName)

                if sellOneMarshmallow(itemName) then
                    totalSold += 1
                else
                    break
                end
            end
        end

        sellingBusy = false

        if totalSold > 0 then
            notify("SELL", "Selesai. Urutan: Large -> Medium -> Small.")
        end

        return totalSold > 0
    end

