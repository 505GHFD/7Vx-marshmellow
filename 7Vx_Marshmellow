    -- Physical keyboard E helper. This is intentionally kept as a real key event so
    -- ProximityPrompt/keyboard-interaction based gameplay can receive the same input.
    local function pressE(holdDuration)
        local now = os.clock()
        if now - lastEPress < E_COOLDOWN then
            task.wait(E_COOLDOWN - (now - lastEPress))
        end
        lastEPress = os.clock()

        holdDuration = math.max(0.03, tonumber(holdDuration) or 0.08)

        -- Keyboard fallback. Cooking now prefers the actual ProximityPrompt
        -- through interactCookingPrompt(), so this remains only a fallback.
        local ok = pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(holdDuration)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)

        return ok
    end

    local function interactCookingPrompt()
        local root = getRoot()
        if not root then return false end

        -- The screenshot shows a real ProximityPrompt on the stove.
        -- Select the nearest enabled prompt around the player instead of
        -- blindly sending a keyboard event.
        local prompt, promptDist = findNearestInteractPrompt(STOVE_DISTANCE + 2, {
            "stove", "cook", "cooking", "pot", "proximity"
        })

        -- Some games name the prompt simply "ProximityPrompt", so retry
        -- without keywords if the keyword pass did not find it.
        if not prompt then
            prompt, promptDist = findNearestInteractPrompt(STOVE_DISTANCE + 2, {})
        end

        if not prompt then
            notify("COOK", "ProximityPrompt stove tidak ditemukan.", true)
            return false
        end

        local part = prompt.Parent
        if part and part:IsA("Attachment") then
            part = part.Parent
        end
        if not part or not part:IsA("BasePart") then
            part = prompt:FindFirstAncestorWhichIsA("BasePart")
        end

        if not part then
            notify("COOK", "Part ProximityPrompt tidak ditemukan.", true)
            return false
        end

        local dist = (root.Position - part.Position).Magnitude
        local maxDist = tonumber(prompt.MaxActivationDistance) or 10
        if dist > maxDist + 1.5 then
            notify("COOK", string.format("Terlalu jauh %.1f / %.1f studs.", dist, maxDist), true)
            return false
        end

        local hold = tonumber(prompt.HoldDuration) or 0
        State.CurrentStep = "INTERACT: " ..
            tostring(prompt.ActionText ~= "" and prompt.ActionText or prompt.Name)

        -- Use the actual ProximityPrompt API first. This is the important fix:
        -- the game receives the same prompt interaction shown by the E bubble.
        local ok = pcall(function()
            if hold > 0 then
                prompt:InputHoldBegin()
                task.wait(hold)
                prompt:InputHoldEnd()
            else
                prompt:InputHoldBegin()
                task.wait(0.08)
                prompt:InputHoldEnd()
            end
        end)

        -- Always release the prompt hold.
        pcall(function()
            prompt:InputHoldEnd()
        end)

        if ok then
            task.wait(0.15)
            return true
        end

        -- Fallback only if the prompt API is unavailable.
        return pressE(math.max(0.08, hold))
    end

    local function promptSearchText(prompt)
        local bits = {
            tostring(prompt.Name or ""),
            tostring(prompt.ActionText or ""),
            tostring(prompt.ObjectText or ""),
            prompt.Parent and tostring(prompt.Parent.Name or "") or "",
            prompt.Parent and prompt.Parent.Parent and tostring(prompt.Parent.Parent.Name or "") or "",
        }
        return string.lower(table.concat(bits, " "))
    end

    findNearestInteractPrompt = function(maxDistance, keywords)
        local root = getRoot()
        if not root then return nil, math.huge end
        maxDistance = tonumber(maxDistance) or 15
        keywords = keywords or {}

        local best, bestDist, bestScore = nil, math.huge, -1
        for _, prompt in ipairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                local parentPart = prompt.Parent
                local part = nil
                if parentPart and parentPart:IsA("BasePart") then
                    part = parentPart
                elseif parentPart and parentPart:IsA("Attachment") and parentPart.Parent and parentPart.Parent:IsA("BasePart") then
                    part = parentPart.Parent
                elseif prompt:FindFirstAncestorWhichIsA("BasePart") then
                    part = prompt:FindFirstAncestorWhichIsA("BasePart")
                end

                if part then
                    local dist = (root.Position - part.Position).Magnitude
                    local allowed = math.min(maxDistance, tonumber(prompt.MaxActivationDistance) or maxDistance)
                    if dist <= allowed + 1 then
                        local haystack = promptSearchText(prompt)
                        local score = (#keywords == 0) and 1 or 0
                        for _, keyword in ipairs(keywords) do
                            local k = string.lower(tostring(keyword))
                            if k ~= "" and string.find(haystack, k, 1, true) then
                                score += 1
                            end
                        end
                        if score > 0 and (score > bestScore or (score == bestScore and dist < bestDist)) then
                            best, bestDist, bestScore = prompt, dist, score
                        end
                    end
                end
            end
        end
        return best, bestDist
    end

    interactPrompt = function(prompt, extraHold)
        if not prompt or not prompt.Parent then return false end
        local root = getRoot()
        if not root then return false end

        local part = prompt.Parent
        if part:IsA("Attachment") then part = part.Parent end
        if not part or not part:IsA("BasePart") then
            part = prompt:FindFirstAncestorWhichIsA("BasePart")
        end
        if not part then return false end

        local dist = (root.Position - part.Position).Magnitude
        local maxDist = tonumber(prompt.MaxActivationDistance) or 10
        if dist > maxDist + 1.5 then
            notify("INTERACT", string.format("Terlalu jauh (%.1f / %.1f studs).", dist, maxDist), true)
            return false
        end

        local hold = tonumber(extraHold)
        if not hold then
            hold = math.max(0.08, tonumber(prompt.HoldDuration) or 0)
        end
        State.CurrentStep = "PRESS E: " .. tostring(prompt.ActionText ~= "" and prompt.ActionText or prompt.Name)
        pressE(hold)
        task.wait(math.max(0.08, State.BuyDelay * 0.15))
        return true
    end

    local STOVE_NAMES = { Stove = true, CookingStove = true, CookingPot = true, Pot = true, StoveTop = true }

    local function isStovePart(object)
        if not object or not object:IsA("BasePart") then return false end
        if object:GetAttribute("IsStove") == true then return true end
        return STOVE_NAMES[object.Name] == true
    end

    local function findNearestStove()
        local root = getRoot()
        if not root then return nil, math.huge end
        local nearest, nearestDist = nil, STOVE_DISTANCE
        for _, object in ipairs(workspace:GetDescendants()) do
            if isStovePart(object) then
                local dist = (root.Position - object.Position).Magnitude
                if dist <= nearestDist then nearest, nearestDist = object, dist end
            end
        end
        activeStove = nearest
        activeStoveDistance = nearestDist
        return nearest, nearestDist
    end

    local function updateActiveStove() return findNearestStove() end
    local function getNearestStove()
        local stove, distance = findNearestStove()
        if stove and distance <= STOVE_DISTANCE then return stove end
        return nil
    end

    local function interactWithStove()
        local stove, distance = findNearestStove()
        if not stove then
            notify("NO STOVE", "Dekati stove sampai berada dalam jarak interaksi.", true)
            return false
        end

        local prompt, promptDist = findNearestInteractPrompt(STOVE_DISTANCE + 2, {"stove", "cook", "cooking", "pot"})
        if prompt and promptDist <= STOVE_DISTANCE + 2 then
            local ok = interactPrompt(prompt)
            if ok then
                log(string.format("E INTERACTION: %s (%.1f studs)", stove:GetFullName(), distance))
            end
            return ok
        end

        -- Fallback for games where the stove uses a keyboard interaction without a visible prompt.
        State.CurrentStep = "E PRESSED"
        pressE(0.08)
        log(string.format("E INTERACTION: %s (%.1f studs)", stove:GetFullName(), distance))
        return true
    end

    local waitingForRealE = false
    local realETriggered = false

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.E then
            local stove = getNearestStove()
            if not stove then return end
            local now = os.clock()
            if now - lastEPress < E_COOLDOWN then return end
            lastEPress = now
            activeStove = stove
            realETriggered = true

            if waitingForRealE then
                State.CurrentStep = "E PRESSED"
                log("REAL E PRESSED: " .. stove:GetFullName())
            else
                State.CurrentStep = "E INTERACTION"
                log("MANUAL E INTERACTION: " .. stove:GetFullName())
            end
        end
    end)

    local function waitForRealE(timeout)
        timeout = timeout or 20
        local stove = getNearestStove()
        if not stove then
            State.CurrentStep = "WAITING FOR STOVE"
            return false
        end
        realETriggered = false
        waitingForRealE = true
        State.CurrentStep = "WAITING FOR E"
        local started = os.clock()

        while not realETriggered do
            if os.clock() - started >= timeout then
                waitingForRealE = false
                State.CurrentStep = "E TIMEOUT"
                return false
            end
            local currentStove = getNearestStove()
            if not currentStove then
                waitingForRealE = false
                State.CurrentStep = "LEFT STOVE"
                return false
            end
            task.wait(0.05)
        end
        waitingForRealE = false
        realETriggered = false
        return true
    end

    local function sendCookStep(step)
        if not interactWithStove() then
            State.CurrentStep = "WAITING FOR E"
            return false
        end

        State.CurrentStep = "INTERACTING: " .. tostring(step or "STEP")
        log("COOK STEP: " .. tostring(step or "STEP"))
        return true
    end

