local function randomDelay(base, minExtra, maxExtra)
    minExtra = minExtra or 0.2
    maxExtra = maxExtra or 0.8
    return base + minExtra + math.random() * (maxExtra - minExtra)
end

local function randomDelay(base, minExtra, maxExtra)
    minExtra = minExtra or 0.2
    maxExtra = maxExtra or 0.8
    return base + minExtra + math.random() * (maxExtra - minExtra)
end

local function runCookSequence()
    if cookingBusy then return end
    cookingBusy = true
    State.Cooking = true

    -- URUTAN MEMASAK YANG BENAR:
    -- Water
    --   -> tunggu 1 detik
    --   -> E
    --   -> tunggu 22 detik
    -- Sugar Block Bag
    --   -> tunggu 1 detik
    --   -> E
    -- Gelatin
    --   -> E
    --   -> tunggu 1 detik
    --   -> E
    --   -> masak sekitar 46 detik
    --   -> E ambil hasil

    local function waitStep(seconds, label)
        State.CurrentStep = label
        task.wait(randomDelay(seconds, 0.15, 0.6))
    end

    local function equipAndInteract(itemName, preEWait, postEWait, label)
        if not State.AutoCook then return false end

        if countItem(itemName) <= 0 then
            notify("MISSING INGREDIENT", itemName, true)
            State.CurrentStep = "MISSING: " .. itemName
            return false
        end

        State.CurrentStep = "EQUIP: " .. itemName
        if not equipItem(itemName) then
            notify("EQUIP FAILED", itemName, true)
            State.CurrentStep = "EQUIP FAILED"
            return false
        end

        task.wait(0.4 + (math.random(1, 5) / 100))

        if preEWait and preEWait > 0 then
            waitStep(preEWait, label or ("WAIT " .. itemName))
        end

        if not State.AutoCook then return false end

        State.CurrentStep = "PRESS E: " .. itemName
        pressE()

        if postEWait and postEWait > 0 then
            waitStep(postEWait, "WAIT AFTER " .. itemName)
        end

        return true
    end

    -- 1. WATER -> tunggu 1 detik -> E -> tunggu 22 detik
    if not equipAndInteract(CFG.WATER, 1, 22, "WAIT WATER 22s") then
        State.Cooking = false
        cookingBusy = false
        return
    end

    -- 2. SUGAR BLOCK BAG -> tunggu 1 detik -> E
    if not equipAndInteract(CFG.SUGAR, 1, 0, "WAIT SUGAR 1s") then
        State.Cooking = false
        cookingBusy = false
        return
    end

    -- 3. GELATIN -> E -> tunggu 1 detik -> E
    if countItem(CFG.GELATIN) <= 0 then
        notify("MISSING INGREDIENT", CFG.GELATIN, true)
        State.CurrentStep = "MISSING: " .. CFG.GELATIN
        State.Cooking = false
        cookingBusy = false
        return
    end

    State.CurrentStep = "EQUIP: " .. CFG.GELATIN
    if not equipItem(CFG.GELATIN) then
        notify("EQUIP FAILED", CFG.GELATIN, true)
        State.CurrentStep = "EQUIP FAILED"
        State.Cooking = false
        cookingBusy = false
        return
    end

    task.wait(0.4 + (math.random(1, 5) / 100))

    if not State.AutoCook then
        State.Cooking = false
        cookingBusy = false
        return
    end

    State.CurrentStep = "PRESS E: GELATIN"
    pressE()

    -- Tunggu 1 detik sebelum E berikutnya.
    waitStep(1, "WAIT GELATIN 1s")

    if not State.AutoCook then
        State.Cooking = false
        cookingBusy = false
        return
    end

    State.CurrentStep = "PRESS E: START COOK"
    pressE()

    -- 4. Masak sekitar 46 detik.
    local cookDelay = randomDelay(46, 0.3, 1.2)
    State.CurrentStep = "COOKING MARSHMALLOW"
    notify("COOKING", string.format("%.1fs", cookDelay))
    task.wait(cookDelay)

    -- 5. E untuk mengambil hasil.
    if State.AutoCook then
        State.CurrentStep = "PRESS E: COLLECT"
        pressE()
        task.wait(0.4 + (math.random(1, 5) / 100))

        State.CookedCount += 1
        State.CurrentStep = "COMPLETE"
        notify("COOK COMPLETE", "Marshmellow Ke " .. tostring(State.CookedCount) .. "x selesai.")
    end

    State.Cooking = false
    cookingBusy = false
end

