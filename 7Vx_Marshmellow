    undergroundPart.Name = "7Vx_UndergroundFloor"
    undergroundPart.Anchored = true
    undergroundPart.CanCollide = true
    undergroundPart.CanTouch = false
    undergroundPart.CanQuery = false
    undergroundPart.Transparency = 0.5
    undergroundPart.Material = Enum.Material.SmoothPlastic
    undergroundPart.BrickColor = BrickColor.new("Dark stone grey")
    undergroundPart.Size = Vector3.new(1000, 1, 1000)

    -- Posisi diatur pas di bawah kaki (asumsi HumanoidRootPart ada di sekitar 3-3.5 studs dari telapak kaki)
    undergroundPart.CFrame = root.CFrame * CFrame.new(0, -3.5, 0)
    undergroundPart.Parent = workspace

    return undergroundPart
end

removeUndergroundFloor = function()
