        -- Right Alt = command palette. Right Ctrl = UI show/hide only; rain/ESP keep running.
        if input.KeyCode == Enum.KeyCode.RightAlt then
            palette.Visible = not palette.Visible
        elseif input.KeyCode == Enum.KeyCode.RightControl then
            if window.Visible then
                window.Visible = false
                minimizedBar.Visible = false
                closedImage.Visible = true
            else
                window.Visible = true
                minimizedBar.Visible = false
                closedImage.Visible = false
                task.defer(applyUIStyle)
            end
        elseif input.KeyCode == Enum.KeyCode.T and State.Blink then
            -- T works globally unless the player is actively typing into a TextBox.
            if not UserInputService:GetFocusedTextBox() then
                doBlinkTP()
            end
        end

        -- ALT + M1 (Klik Kiri) untuk menghapus (menembus) dinding (One Way / Tidak bisa restore)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and State.WallDeleteMode and isAltPressed then
            local mouse = Player:GetMouse()
            local target = mouse.Target
            if target and target:IsA("BasePart") then
                local wasHidden = target.LocalTransparencyModifier == 1
                if not wasHidden then
                    -- Simpan kolisi aslinya jika kita ingin restore via ALT+Z
                    hiddenWalls[target] = target.CanCollide
                    
                    target.LocalTransparencyModifier = 1
                    target.CanCollide = false
                    notify("WALL DEBUG", "Deleted & Passable: " .. target:GetFullName())
                else
                    -- Jika sudah disembunyikan, klik lagi tidak akan memulihkannya.
                    notify("WALL DEBUG", "Cannot restore by clicking. Use ALT+Z.")
                end
            end
        end
    end)

    --==================================================
    -- UNDERGROUND 1000x1000 FLOOR DYNAMIC
    --==================================================
    createUndergroundFloor = function()
        local root = getRoot()
        if not root then return nil end

        if undergroundPart and undergroundPart.Parent then
            undergroundPart.Color = CFG.PURPLE
            undergroundPart.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.6, root.Position.Z)
            State.Underground = true
            return undergroundPart
        end

        -- Put the player below the normal map first, then create the floor slightly below them.
        local targetCFrame = root.CFrame + Vector3.new(0, -7, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = targetCFrame
        task.wait(0.08)

        undergroundPart = Instance.new("Part")
        undergroundPart.Name = "7Vx_UndergroundFloor"
        undergroundPart.Anchored = true
        undergroundPart.CanCollide = true
        undergroundPart.CanTouch = false
        undergroundPart.CanQuery = false
        undergroundPart.CastShadow = false
        undergroundPart.Transparency = 0.18
        undergroundPart.Material = Enum.Material.Neon
        undergroundPart.Color = CFG.PURPLE
        undergroundPart.Size = Vector3.new(1000, 1, 1000)
        undergroundPart.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.6, root.Position.Z)
        undergroundPart.Parent = workspace

        State.Underground = true
        log("UNDERGROUND FLOOR CREATED")
        notify("UNDERGROUND", "ON | 1000x1000 floor aktif.")
        return undergroundPart
    end

    removeUndergroundFloor = function()
        local root = getRoot()
        if undergroundPart then
            undergroundPart:Destroy()
            undergroundPart = nil
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = root.CFrame + Vector3.new(0, 7, 0)
        end
        State.Underground = false
    end


    Players.PlayerAdded:Connect(function(plr)
        if plr == Player then return end
    end)

    Player.CharacterAdded:Connect(function(char)
        stopVehicleFly(true)
        task.wait(0.6)
        if State.Underground then
            createUndergroundFloor()
        end
        if State.ESP and espOverlay then
            espOverlay.Enabled = true
        end
    end)
    _G["7VxCreateUnderground"] = createUndergroundFloor
    _G["7VxRemoveUnderground"] = removeUndergroundFloor

    log("7Vx Marshmellow Loaded Successfully.")
    renderTab()
