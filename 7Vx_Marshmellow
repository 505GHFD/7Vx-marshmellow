    -- Holdable +/- button used by BUY quantity controls. It does not re-render the tab
    -- while held, so the mouse/touch hold remains stable and the counter updates live.
    local function holdAdjustButton(parent, value, x, y, w, h, delta, getText, setValue)
        local b = new("TextButton", { Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundColor3 = CFG.PANEL2, BorderSizePixel = 0, Text = value, TextColor3 = CFG.TEXT, Font = CFG.FONT, TextSize = 12, AutoButtonColor = false }, parent)
        round(b, 7)
        local holding = false
        local function applyOnce()
            setValue(delta)
            local ok, txt = pcall(getText)
            if ok and txt then
                local label = parent:FindFirstChild("BuyAmountLive")
                if label then label.Text = txt end
                -- Keep all BUY buttons in the current tab synced while the +/- key is held.
                if content then
                    for _, obj in ipairs(content:GetDescendants()) do
                        if obj:IsA("TextButton") and obj:GetAttribute("BuyQuantityButton") then
                            obj.Text = "BUY " .. tostring(State.BuyAmount) .. "x"
                        end
                    end
                end
            end
        end
        b.MouseButton1Click:Connect(function() applyOnce() end)
        b.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if holding then return end
                holding = true
                task.delay(0.35, function()
                    if not holding then return end
                    while holding and b.Parent do
                        applyOnce()
                        task.wait(0.08)
                    end
                end)
            end
        end)
        b.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                holding = false
            end
        end)
        b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = CFG.PURPLE_DARK}):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = CFG.PANEL2}):Play() end)
        return b
    end
