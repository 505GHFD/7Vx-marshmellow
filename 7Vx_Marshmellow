local function new(class, properties, parent)
    local obj = Instance.new(class)
    for k, v in pairs(properties or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    new("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, obj)
end

local function outline(obj, color, thickness)
    new("UIStroke", { Color = color or CFG.PURPLE, Thickness = thickness or 1, Transparency = 0.25 }, obj)
end

local function getCharacter() return Player.Character end
local function getRoot() return getCharacter() and getCharacter():FindFirstChild("HumanoidRootPart") end
local function getHumanoid() return getCharacter() and getCharacter():FindFirstChildOfClass("Humanoid") end

local function formatMoney(amt)
    amt = math.floor(amt or 0)
    local formatted = tostring(amt)
    while true do
        local newText, count = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        formatted = newText
        if count == 0 then break end
    end
    return "$" .. formatted
end

local function makeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

