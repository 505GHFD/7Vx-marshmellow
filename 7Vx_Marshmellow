    local function formatMoney(amt)
        amt = math.floor(amt or 0)
        local formatted = tostring(amt)
        while true do
            local newText, count = formatted:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
            formatted = newText
            if count == 0 then break end
        end
        return "$" .. formatted
    end

    local function makeDraggable(guiObject)
        local dragging, dragInput, dragStart, startPos
        local auraLayer = Instance.new("Folder")
        auraLayer.Name = "DragAuraTrail"
        auraLayer.Parent = gui

        local lastTrail = 0

        local function spawnDragAura(pos)
            local now = os.clock()
            if now - lastTrail < 0.025 then return end
            lastTrail = now

            local glow = Instance.new("Frame")
            glow.Name = "DragAura"
            glow.AnchorPoint = Vector2.new(0.5, 0.5)
            local center = guiObject.AbsolutePosition + (guiObject.AbsoluteSize / 2)
            glow.Position = UDim2.fromOffset(center.X, center.Y)
            glow.Size = UDim2.fromOffset(18, 18)
            glow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            glow.BackgroundTransparency = 0.55
            glow.BorderSizePixel = 0
            glow.ZIndex = 0
            glow.Parent = auraLayer
            round(glow, 999)

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(255, 255, 255)
            stroke.Thickness = 2
            stroke.Transparency = 0.15
            stroke.Parent = glow

            local tween = TweenService:Create(
                glow,
                TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {
                    Size = UDim2.fromOffset(54, 54),
                    BackgroundTransparency = 1
                }
            )
            local strokeTween = TweenService:Create(
                stroke,
                TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Transparency = 1}
            )
            tween:Play()
            strokeTween:Play()
            tween.Completed:Connect(function()
                if glow then glow:Destroy() end
            end)
        end

        guiObject.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = guiObject.Position
                spawnDragAura(input.Position)

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        guiObject.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                local target = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )

                -- Sedikit smoothing agar gerakan panel terasa lebih halus.
                guiObject.Position = UDim2.new(
                    target.X.Scale,
                    guiObject.Position.X.Offset + (target.X.Offset - guiObject.Position.X.Offset) * 0.72,
                    target.Y.Scale,
                    guiObject.Position.Y.Offset + (target.Y.Offset - guiObject.Position.Y.Offset) * 0.72
                )

                spawnDragAura(input.Position)
            end
        end)
    end

