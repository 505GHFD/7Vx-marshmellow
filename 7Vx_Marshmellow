    local waypointFolder = Instance.new("Folder")
    waypointFolder.Name = "7Vx_LocalWaypoints"
    waypointFolder.Parent = workspace

    local function saveWaypoint(name, color)
        local root = getRoot()
        if not root then
            notify("WAYPOINT", "Character belum siap.", true)
            return false
        end

        State.WaypointCounter += 1
        local waypointName = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if waypointName == "" then
            waypointName = "Waypoint " .. tostring(State.WaypointCounter)
        end

        local data = {
            Id = State.WaypointCounter,
            Name = waypointName,
            Position = root.Position,
            Color = color or CFG.PURPLE,
            Visual = nil
        }

        table.insert(State.Waypoints, data)
        log("WAYPOINT SAVED: " .. waypointName)
        return data
    end

    local function createWaypointVisual(data)
        if data.Visual and data.Visual.Parent then data.Visual:Destroy() end
        if not State.ShowWaypoints then data.Visual = nil return end

        local part = Instance.new("Part")
        part.Name = "Waypoint_" .. tostring(data.Id)
        part.Size = Vector3.new(0.8, 0.8, 0.8)
        part.Shape = Enum.PartType.Ball
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.Material = Enum.Material.Neon
        part.Color = data.Color or CFG.PURPLE
        part.Transparency = 0.1
        part.Position = data.Position
        part.Parent = waypointFolder

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "WaypointLabel"
        billboard.Size = UDim2.fromOffset(180, 50)
        billboard.StudsOffset = Vector3.new(0, 1.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = part

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = "● " .. data.Name
        label.TextColor3 = CFG.TEXT
        label.TextStrokeTransparency = 0.35
        label.Font = CFG.FONT
        label.TextSize = 12
        label.Parent = billboard

        data.Visual = part
    end

    local function refreshWaypointVisuals()
        for _, data in ipairs(State.Waypoints) do createWaypointVisual(data) end
    end

    local function deleteWaypoint(index)
        local data = State.Waypoints[index]
        if not data then return end
        if data.Visual then data.Visual:Destroy() end
        table.remove(State.Waypoints, index)
        notify("WAYPOINT", "Deleted")
        renderTab()
    end

