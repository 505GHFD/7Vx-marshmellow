    -- True 3D character bounding box projected to screen.
    -- This uses Model:GetBoundingBox(), so the box follows the complete
    -- character model instead of a fixed-size 2D rectangle.
    local function getCharacterBounds(char)
        if not char or not char.Parent then return nil end

        local camera = workspace.CurrentCamera
        if not camera then return nil end

        local cf, size = char:GetBoundingBox()
        local half = size * 0.5

        local corners = {
            Vector3.new(-half.X, -half.Y, -half.Z),
            Vector3.new(-half.X, -half.Y,  half.Z),
            Vector3.new(-half.X,  half.Y, -half.Z),
            Vector3.new(-half.X,  half.Y,  half.Z),
            Vector3.new( half.X, -half.Y, -half.Z),
            Vector3.new( half.X, -half.Y,  half.Z),
            Vector3.new( half.X,  half.Y, -half.Z),
            Vector3.new( half.X,  half.Y,  half.Z),
        }

        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge
        local anyFront = false
        local anyOnScreen = false

        for _, localCorner in ipairs(corners) do
            local worldCorner = cf:PointToWorldSpace(localCorner)
            local v, onScreen = camera:WorldToViewportPoint(worldCorner)

            if v.Z > 0 then
                anyFront = true
                minX = math.min(minX, v.X)
                minY = math.min(minY, v.Y)
                maxX = math.max(maxX, v.X)
                maxY = math.max(maxY, v.Y)
                anyOnScreen = anyOnScreen or onScreen
            end
        end

        if not anyFront then
            return nil
        end

        return minX, minY, maxX, maxY, anyOnScreen
    end

