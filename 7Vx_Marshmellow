    local function updateSkeleton(data, char)
        local pairsList = {
            {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
            {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
            {"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},
            {"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
            {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},
            {"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},
            {"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},

            -- R6 fallback pairs
            {"Head","Torso"},{"Torso","Left Arm"},{"Left Arm","Left Leg"},
            {"Torso","Right Arm"}
        }

        local color = getESPColor()

        for i, pair in ipairs(pairsList) do
            local line = data.skeleton[i]
            local a = char:FindFirstChild(pair[1])
            local b = char:FindFirstChild(pair[2])

            line.BackgroundColor3 = color

            if State.ESP and a and b then
                local ap, ao = getScreenPoint(a)
                local bp, bo = getScreenPoint(b)

                if ap and bp and (ao or bo) then
                    setLine(line, ap, bp, 2)
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end

    local function updateESPPlayer(player, data, char, hum, dist)
        local color = getESPColor()

        data.boxStroke.Color = color
        data.healthFill.BackgroundColor3 = color
        data.info.TextColor3 = color

        local minX, minY, maxX, maxY, onScreen = getCharacterBounds(char)

        if minX and maxX and onScreen then
            local w = math.max(2, maxX - minX)
            local h = math.max(2, maxY - minY)

            -- Exact projected 3D bounding box.
            data.box.Position = UDim2.fromOffset(minX, minY)
            data.box.Size = UDim2.fromOffset(w, h)
            data.box.Visible = State.BoxESP

            data.healthBack.Position = UDim2.fromOffset(minX - 6, minY)
            data.healthBack.Size = UDim2.fromOffset(3, h)
            data.healthBack.Visible = State.ShowHealth

            local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            data.healthFill.Size = UDim2.new(1, 0, hp, 0)
            data.healthFill.Position = UDim2.new(0, 0, 1, 0)

            local lines = {}

            if State.ShowName then
                table.insert(lines, player.DisplayName .. "  @" .. player.Name)
            end

            if State.ShowStuds then
                table.insert(lines, string.format("%.1f studs", dist))
            end

            if State.ShowHold then
                table.insert(lines, "HOLD: " .. getHeldItem(player))
            end

            if State.ShowInventory then
                local inv = getInventory(player)
                local parts = {}

                for n, c in pairs(inv or {}) do
                    table.insert(parts, n .. " x" .. c)
                end

                table.sort(parts)
                table.insert(lines, #parts > 0 and
                    ("INV: " .. table.concat(parts, ", ")) or "INV: -")
            end

            data.info.Position = UDim2.fromOffset(minX, math.max(2, minY - 32))
            data.info.Size = UDim2.fromOffset(w, 30)
            data.info.Text = table.concat(lines, "\n")
            data.info.Visible =
                State.ShowName or State.ShowStuds or State.ShowHold or State.ShowInventory
        else
            data.box.Visible = false
            data.healthBack.Visible = false
            data.info.Visible = false

            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end

            data.tracer.Visible = false
        end

        updateSkeleton(data, char)
    end

