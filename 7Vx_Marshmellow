    local function runCookSequence()
        if cookingBusy then return end
        cookingBusy = true
        State.Cooking = true

        -- Exact sequence:
        -- Equip Water -> 1s -> stove ProximityPrompt -> 22s
        -- Equip Sugar Block Bag -> 1s -> stove ProximityPrompt
        -- Equip Gelatin -> 1s -> stove ProximityPrompt -> 46s
        -- Equip Empty Bag -> 1s -> stove ProximityPrompt -> complete notification

        local function stopCooking()
            State.Cooking = false
            cookingBusy = false
        end

        local function cookInteract(label)
            if not State.AutoCook then return false end
            State.CurrentStep = label
            return interactCookingPrompt()
        end

        -- WATER
        if not equipForCook(CFG.WATER) then
            stopCooking()
            return
        end

        State.CurrentStep = "HOLD: WATER"
        task.wait(1)

        if not cookInteract("INTERACT: WATER") then
            stopCooking()
            return
        end

        task.wait(22)

        -- SUGAR BLOCK BAG
        if not equipForCook(CFG.SUGAR) then
            stopCooking()
            return
        end

        State.CurrentStep = "HOLD: SUGAR BLOCK BAG"
        task.wait(1)

        if not cookInteract("INTERACT: SUGAR BLOCK BAG") then
            stopCooking()
            return
        end

        -- GELATIN
        if not equipForCook(CFG.GELATIN) then
            stopCooking()
            return
        end

        State.CurrentStep = "HOLD: GELATIN"
        task.wait(1)

        if not cookInteract("INTERACT: GELATIN") then
            stopCooking()
            return
        end

        task.wait(46)

        -- EMPTY BAG
        if not equipForCook(CFG.EMPTY_BAG) then
            stopCooking()
            return
        end

        State.CurrentStep = "HOLD: EMPTY BAG"
        task.wait(1)

        if not cookInteract("INTERACT: EMPTY BAG") then
            stopCooking()
            return
        end

        task.wait(0.4)

        State.CookedCount += 1
        State.CurrentStep = "COMPLETE"
        notify("COOK COMPLETE", "Marshmellow Ke " .. tostring(State.CookedCount) .. "X selesai.")

        stopCooking()
    end

